# ===== TradeSense environment template =====
# Copy backend settings to backend/.env for local development.
# For Docker Compose port interpolation, copy this file to .env at the project root
# or export the port variables in your shell.

# --- Local ports ----------------------------------------------------------
# Keep TradeSense separate from the cross-market radar on port 8000.
TRADESENSE_BACKEND_PORT=8001
TRADESENSE_FRONTEND_PORT=5173
# Optional full proxy override; normally derived from TRADESENSE_BACKEND_PORT.
# VITE_BACKEND_TARGET=http://127.0.0.1:8001

# --- Database -------------------------------------------------------------
# Local one-click default (file created automatically):
DATABASE_URL=sqlite:///./data/tradesense.db  # relative to backend/, auto-created
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://tradesense:secret@db:5432/tradesense

# --- Security -------------------------------------------------------------
# MUST be changed in any shared/production deployment
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Optional AI layer (everything works without it) ----------------------
# none | openai_compat | ollama
AI_PROVIDER=none
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_TIMEOUT_SECONDS=25

# --- Demo data ------------------------------------------------------------
# Seed the demo organization on first start (set 0 for production)
SEED_DEMO_DATA=1

# --- Connector credentials (leave empty to stay in simulated mode) --------
# Email (IMAP, read-only; drafts only, never auto-send)
IMAP_PASSWORD=
# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
